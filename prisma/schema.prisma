// Eks-Food — Food Services Operating System
// Multi-tenant, configurable, event-driven schema.
// NOTE: SQLite is used in this environment. Enums/array types are encoded as
// JSON strings or pipe-separated values and validated at the application layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy & Identity
// ---------------------------------------------------------------------------

model Organization {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  country       String
  baseCurrency  String   @default("GHS")
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED | PENDING_VERIFICATION
  // Optional: links to the extensible OrganizationType registry
  typeId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  type             OrganizationType?  @relation(fields: [typeId], references: [id])
  users            User[]
  cooks            Cook[]
  customers        Customer[]
  services         Service[]
  mealCategories   MealCategory[]
  regions          Region[]
  bookings         Booking[]
  payments         PayswapPayment[]
  transfers        PayswapTransfer[]
  inspections      Inspection[]
  demandSignals    DemandSignal[]
  auditLogs        AuditLog[]
  featureFlags     FeatureFlag[]
  pricingRules     PricingRule[]
  memberships      Membership[]
  teams            Team[]
  invitations      Invitation[]
  tenantConfig     TenantConfiguration?
  flagAssignments  FeatureFlagAssignment[]
  sessions         Session[]
  verificationRequests VerificationRequest[]
  notifications    NotificationLog[]
}

model User {
  id               String   @id @default(cuid())
  organizationId   String
  email            String   @unique
  name             String
  phone            String?
  // Legacy comma-separated role set (kept for M1 compat; M2 uses Membership+Role).
  roles            String   @default("CUSTOMER")
  // ACTIVE | SUSPENDED | PENDING | LOCKED | DELETED
  status           String   @default("ACTIVE")
  avatarUrl        String?
  locale           String   @default("en")
  payswapCustomerId String? // Payswap Customer reference (no card data)
  // Brute-force protection: increments on failed login, resets on success
  failedLoginAttempts Int   @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  deletedAt        DateTime? // soft delete
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id])
  customerProfile  Customer?
  cookProfile      Cook?
  auditLogs        AuditLog[]
  identities       Identity[]
  sessions         Session[]
  devices          Device[]
  memberships      Membership[]
  mfaConfigs       MFAConfiguration[]
  recoveryCodes    RecoveryCode[]
  loginHistory     LoginHistory[]
  preferences      UserPreference?
  verificationRequests VerificationRequest[]
  notifications    NotificationLog[]

  @@index([organizationId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Customer Platform
// ---------------------------------------------------------------------------

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  userId         String   @unique
  dietaryPrefs   String   @default("") // pipe-separated tags
  favoriteCuisines String @default("")
  rating         Float    @default(5.0)
  totalBookings  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  addresses      Address[]
  bookings       Booking[]    @relation("CustomerBookings")
  favorites      Favorite[]

  @@index([organizationId])
}

model Address {
  id          String   @id @default(cuid())
  customerId  String
  label       String   @default("Home")
  line1       String
  city        String
  region      String
  lat         Float
  lng         Float
  instructions String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Favorite {
  id         String @id @default(cuid())
  customerId String
  cookId     String
  createdAt  DateTime @default(now())

  customer   Customer @relation(fields: [customerId], references: [id])
  cook       Cook     @relation(fields: [cookId], references: [id])

  @@unique([customerId, cookId])
}

// ---------------------------------------------------------------------------
// Cook Platform
// ---------------------------------------------------------------------------

model Cook {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String   @unique
  bio             String   @default("")
  // pipe-separated cuisines, e.g. "ghanaian|nigerian|vegan"
  cuisines        String   @default("")
  // pipe-separated skills, e.g. "grilling|baking|pastry"
  skills          String   @default("")
  // pipe-separated languages
  languages       String   @default("en")
  hourlyRate      Float    @default(50)
  currency        String   @default("GHS")
  rating          Float    @default(5.0)
  totalJobs       Int      @default(0)
  completedJobs   Int      @default(0)
  responseTimeMins Int     @default(15)
  // PENDING | APPROVED | SUSPENDED | REJECTED
  verificationStatus String @default("PENDING")
  homeRegion       String?
  lat              Float?
  lng              Float?
  availabilityMode String   @default("FLEXIBLE") // FLEXIBLE | SCHEDULED | UNAVAILABLE
  portfolioUrl     String?
  avatarUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  certifications  Certification[]
  availability    CookAvailability[]
  bookings        Booking[]    @relation("CookBookings")
  favorites       Favorite[]
  inspections     Inspection[]

  @@index([organizationId])
  @@index([verificationStatus])
}

model CookAvailability {
  id        String   @id @default(cuid())
  cookId    String
  // ISO weekday 0-6
  weekday   Int
  startHour Int
  endHour   Int
  createdAt DateTime @default(now())

  cook      Cook @relation(fields: [cookId], references: [id], onDelete: Cascade)

  @@index([cookId])
}

model Certification {
  id            String   @id @default(cuid())
  cookId        String
  title         String
  issuer        String
  // PENDING | VERIFIED | EXPIRED | REVOKED
  status        String   @default("PENDING")
  issuedAt      DateTime?
  expiresAt     DateTime?
  inspectorId   String?
  publicBadgeId String?
  createdAt     DateTime @default(now())

  cook          Cook @relation(fields: [cookId], references: [id], onDelete: Cascade)

  @@index([cookId])
}

// ---------------------------------------------------------------------------
// Configurable Catalog (Admin-driven — never hardcoded)
// ---------------------------------------------------------------------------

model Service {
  id            String   @id @default(cuid())
  organizationId String
  code          String   // e.g. IN_HOME_COOKING, MEAL_PREP, EVENT_CATERING
  name          String
  description   String
  basePrice     Float
  currency      String   @default("GHS")
  estimatedMins Int      @default(120)
  active        Boolean  @default(true)
  config        String   @default("{}") // JSON blob for service-specific rules
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id])
  bookings      Booking[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model MealCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  icon           String?
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model Region {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  country        String
  // GeoJSON-ish bounding box encoded as JSON: {ne:{lat,lng}, sw:{lat,lng}}
  bounds         String
  active         Boolean  @default(true)
  managerId      String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model PricingRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // SLIDER | FIXED | SURGE | TIERED
  kind           String
  // JSON: {param: value}, e.g. {"perHour": 40, "minCharge": 60}
  config         String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model FeatureFlag {
  id             String   @id @default(cuid())
  organizationId String
  key            String
  enabled        Boolean  @default(false)
  // JSON rollout config
  config         String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
}

// ---------------------------------------------------------------------------
// Booking Engine & Dispatch
// ---------------------------------------------------------------------------

model Booking {
  id             String   @id @default(cuid())
  organizationId String
  code           String   @unique // human-friendly EKS-XXXX
  customerId     String
  cookId         String?
  serviceId      String
  // IMMEDIATE | SCHEDULED | RECURRING | EVENT | CORPORATE | SUBSCRIPTION
  bookingType    String
  scheduledFor   DateTime
  durationMins   Int      @default(120)
  partySize      Int      @default(2)
  addressLine1   String
  city           String
  region         String
  lat            Float
  lng            Float
  notes          String?
  // DRAFT | PENDING_MATCH | ASSIGNED | CONFIRMED | EN_ROUTE | IN_PROGRESS | COMPLETED | CANCELLED | ESCALATED
  status         String   @default("DRAFT")
  matchScore     Float?
  // JSON: {distance, rating, availability, cuisine, price, language, preference}
  matchDebug     String?
  quotedPrice    Float
  currency       String   @default("GHS")
  payswapPaymentId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  customer       Customer     @relation("CustomerBookings", fields: [customerId], references: [id])
  cook           Cook?        @relation("CookBookings", fields: [cookId], references: [id])
  service        Service      @relation(fields: [serviceId], references: [id])

  @@index([organizationId])
  @@index([customerId])
  @@index([cookId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Payswap Payment Abstraction (Stripe-like, no sensitive data stored)
// ---------------------------------------------------------------------------

model PayswapPayment {
  id             String   @id @default(cuid())
  organizationId String
  payswapId      String   @unique // Payswap Payment Intent / Charge ID
  bookingCode    String?
  customerId     String? // internal user id
  payswapCustomerId String?
  amount         Float
  currency       String   @default("GHS")
  // REQUIRES_ACTION | REQUIRES_CONFIRMATION | SUCCEEDED | CANCELLED | FAILED | REFUNDED
  status         String
  // JSON: {method, last4, brand} — references only, never raw card data
  methodSummary  String   @default("{}")
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([bookingCode])
  @@index([status])
}

model PayswapTransfer {
  id             String   @id @default(cuid())
  organizationId String
  payswapId      String   @unique // Payswap Transfer ID (worker payout)
  payeeUserId    String
  amount         Float
  currency       String   @default("GHS")
  // PENDING | IN_TRANSIT | PAID | FAILED | CANCELLED
  status         String
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([payeeUserId])
}

// ---------------------------------------------------------------------------
// Food Inspector Platform
// ---------------------------------------------------------------------------

model Inspection {
  id             String   @id @default(cuid())
  organizationId String
  cookId         String
  inspectorId    String?
  // CERTIFICATION | COMPLAINT | ROUTINE | RENEWAL
  kind           String
  // SCHEDULED | IN_PROGRESS | PASSED | FAILED | PENDING_REVIEW
  status         String   @default("SCHEDULED")
  scheduledFor   DateTime
  completedAt    DateTime?
  score          Float?
  // JSON array of checklist items
  checklist      String   @default("[]")
  report         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  cook           Cook         @relation(fields: [cookId], references: [id])

  @@index([organizationId])
  @@index([cookId])
}

// ---------------------------------------------------------------------------
// Food Intelligence Platform (aggregated, anonymized)
// ---------------------------------------------------------------------------

model DemandSignal {
  id             String   @id @default(cuid())
  organizationId String
  region         String
  cuisine        String
  // ISO date (YYYY-MM-DD)
  day            String
  hour           Int
  demandScore    Float    // normalized 0-100
  avgPrice       Float
  bookings       Int      @default(0)
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, region, day])
}

// ---------------------------------------------------------------------------
// Audit & Observability
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  // JSON payload
  metadata       String   @default("{}")
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User?        @relation(fields: [actorUserId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Event Infrastructure — transactional outbox (foundation)
// ---------------------------------------------------------------------------
// The outbox guarantees at-least-once event delivery without dual-write
// inconsistency: domain events are staged in the same DB transaction as the
// aggregate write, then a worker relays them to the event bus.
//
// PostgreSQL-ready: in production, swap `provider = "sqlite"` for
// `provider = "postgresql"` and add `@db.Uuid` / `@db.Timestamptz` annotations.
// The column shapes are deliberately provider-agnostic.

model EventOutbox {
  id             String   @id @default(cuid())
  organizationId String
  // Event envelope
  eventId        String   @unique
  eventType      String
  aggregateType  String
  aggregateId    String
  payload        String   @default("{}") // JSON
  metadata       String   @default("{}") // JSON: correlation/causation/trace IDs
  version        Int      @default(1)
  // Relay lifecycle: PENDING → PUBLISHED | FAILED
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  publishedAt    DateTime?

  @@index([organizationId, status, createdAt])
  @@index([aggregateType, aggregateId])
}

// ---------------------------------------------------------------------------
// Foundation conventions (see docs/DATABASE.md)
// ---------------------------------------------------------------------------
// Every business model in future milestones MUST follow:
//   • id:        UUID @id @default(uuid())       (PostgreSQL) / cuid() (SQLite)
//   • createdAt: DateTime @default(now())
//   • updatedAt: DateTime @updatedAt
//   • deletedAt: DateTime?                        (soft delete)
//   • version:   Int @default(1)                  (optimistic locking)
//   • organizationId: String  (multi-tenant isolation)
// These columns are added per-model in their respective milestones; the
// shared kernel types (@eks/common) define the matching TS contracts.

// ===========================================================================
// Milestone 2 — Identity & Access Management (IAM)
// ===========================================================================
// Every tenant-scoped model carries `organizationId` for strict multi-tenant
// isolation. Repository + policy layers enforce it; no cross-tenant access is
// possible by construction. See docs/identity/MULTI_TENANCY.md.
// ===========================================================================

// --- Organization Types (extensible — data, not code) ---

model OrganizationType {
  id          String   @id @default(cuid())
  code        String   @unique // HOUSEHOLD | RESTAURANT | VENDOR | SUPPLIER | CATERING | FRANCHISE | INSPECTION_AGENCY | LOGISTICS | ENTERPRISE
  name        String
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  organizations Organization[]
}

// --- Identity (a User may have multiple Identities — email, phone, passkey, social) ---

model Identity {
  id              String   @id @default(cuid())
  userId          String
  // EMAIL | PHONE | PASSKEY | MAGIC_LINK | GOOGLE | APPLE | SSO
  provider        String
  // The unique identifier for this identity at the provider (email, phone, subject)
  subject         String
  // Hashed credential (password hash, or null for passwordless)
  credentialHash  String?
  // JSON: provider-specific metadata (e.g. WebAuthn public key, OAuth profile)
  metadata        String   @default("{}")
  verified        Boolean  @default(false)
  verifiedAt      DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@index([provider, subject])
}

// --- Extended User fields for IAM (existing User model gains relations) ---

// NOTE: The existing User model is augmented via Prisma relation additions below.

// --- Sessions & Devices ---

model Session {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String   // active tenant for this session
  // Opaque session token (hashed in storage; the raw token is the cookie value)
  tokenHash       String   @unique
  refreshHash     String?  @unique
  refreshFamily   String?  // detects refresh-token reuse (replay attack mitigation)
  deviceFingerprint String?
  userAgent       String?
  ipAddress       String?
  // LOW | MEDIUM | HIGH
  riskScore       String   @default("LOW")
  trustedDevice   Boolean  @default(false)
  expiresAt       DateTime
  refreshExpiresAt DateTime?
  lastActiveAt    DateTime @default(now())
  revokedAt       DateTime?
  revokeReason    String?
  createdAt       DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([tokenHash])
}

model Device {
  id              String   @id @default(cuid())
  userId          String
  fingerprint     String
  label           String?  // "MacBook Pro — Accra"
  platform        String?
  trusted         Boolean  @default(false)
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  revokedAt       DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
}

// --- Roles, Permissions, Policies ---

model Role {
  id              String   @id @default(cuid())
  organizationId  String?  // null = global role; set = org-scoped role
  code            String   // SUPER_ADMIN | OWNER | ADMIN | MANAGER | MEMBER | VIEWER | custom
  name            String
  description     String?
  // GLOBAL | ORGANIZATION | TEAM
  scope           String   @default("ORGANIZATION")
  isSystem        Boolean  @default(false) // system roles cannot be deleted
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Membership[]
  invitations     Invitation[]
  rolePermissions RolePermission[]
  teamMembers     TeamMember[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Permission {
  id              String   @id @default(cuid())
  code            String   @unique // booking.create | admin.config | ...
  name            String
  description     String?
  // The resource group for the permission explorer
  resource        String   // booking | cook | payment | admin | ...
  createdAt       DateTime @default(now())

  rolePermissions RolePermission[]
  policies        Policy[]
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Policy {
  id              String   @id @default(cuid())
  name            String
  description     String?
  // The permission this policy governs
  permissionId    String
  // JSON ABAC rules: { ownership: true, hierarchy: "ORG", scope: "REGION", timeWindow: {...}, features: [...] }
  rules           String   @default("{}")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@index([permissionId])
}

// --- Membership & Teams ---

model Membership {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String
  roleId          String
  // ACTIVE | SUSPENDED | REVOKED
  status          String   @default("ACTIVE")
  invitedById     String?
  acceptedAt      DateTime?
  suspendedAt     DateTime?
  expiresAt       DateTime? // temporary access
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])
  teamMembers  TeamMember[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Team {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  // KITCHEN | PROCUREMENT | DELIVERY | INSPECTION | OPERATIONS | FINANCE | HR | custom
  kind            String   @default("OPERATIONS")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members TeamMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model TeamMember {
  id           String   @id @default(cuid())
  teamId       String
  membershipId String
  roleId       String?  // optional team-level role override
  createdAt    DateTime @default(now())

  team       Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role?      @relation(fields: [roleId], references: [id])

  @@unique([teamId, membershipId])
  @@index([teamId])
}

// --- Invitations ---

model Invitation {
  id              String   @id @default(cuid())
  organizationId  String
  email           String
  invitedById     String
  roleId          String
  // PENDING | ACCEPTED | REVOKED | EXPIRED
  status          String   @default("PENDING")
  tokenHash       String   @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedByUserId String?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@index([organizationId])
  @@index([email])
  @@index([status])
}

// --- MFA ---

model MFAConfiguration {
  id              String   @id @default(cuid())
  userId          String
  // TOTP | PASSKEY | SMS | EMAIL
  method          String
  // TOTP: base32 secret (encrypted); PASSKEY: WebAuthn credential ID JSON
  secret          String
  // Encrypted at rest with @eks/security
  encrypted       Boolean  @default(true)
  enabled         Boolean  @default(false)
  enrolledAt      DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, method])
  @@index([userId])
}

model RecoveryCode {
  id              String   @id @default(cuid())
  userId          String
  // Hashed (Argon2) — never store plaintext recovery codes
  codeHash        String   @unique
  usedAt          DateTime?
  usedFromIp      String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// --- Login History & Audit (extends existing AuditLog) ---

model LoginHistory {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String?
  // SUCCESS | FAILED | LOCKED | MFA_CHALLENGED | MFA_FAILED
  result          String
  method          String   // PASSWORD | MAGIC_LINK | PASSKEY | SSO
  ipAddress       String?
  userAgent       String?
  deviceFingerprint String?
  failureReason   String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([result])
}

// --- User Preferences & Tenant Configuration ---

model UserPreference {
  id              String   @id @default(cuid())
  userId          String
  language        String   @default("en")
  timezone        String   @default("Africa/Accra")
  dateFormat      String   @default("YYYY-MM-DD")
  currency        String   @default("GHS")
  // accessibility prefs as JSON
  accessibility   String   @default("{}")
  emailNotifications Boolean @default(true)
  smsNotifications   Boolean @default(false)
  pushNotifications  Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

model TenantConfiguration {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  // JSON: branding {primaryColor, logoUrl, ...}
  branding        String   @default("{}")
  // JSON: localization {defaultLanguage, supportedLanguages, ...}
  localization    String   @default("{}")
  // JSON: feature flag overrides
  featureFlags    String   @default("{}")
  // JSON: custom preferences
  preferences     String   @default("{}")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model FeatureFlagAssignment {
  id              String   @id @default(cuid())
  organizationId  String
  flagKey         String
  enabled         Boolean
  rolloutPercent  Int      @default(100)
  // JSON: per-user overrides
  overrides       String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, flagKey])
  @@index([organizationId])
}

// --- Verification framework (interface-only in M2) ---

model VerificationRequest {
  id              String   @id @default(cuid())
  userId          String
  organizationId  String?
  // GOVERNMENT_ID | BUSINESS | ADDRESS | FOOD_SAFETY_LICENSE | PROFESSIONAL_CERT
  kind            String
  provider        String   @default("manual")
  // PENDING | IN_REVIEW | APPROVED | REJECTED | EXPIRED
  status          String   @default("PENDING")
  // JSON: provider-specific request payload (references only — never raw documents)
  payload         String   @default("{}")
  // JSON: provider response (status, score, reference)
  result          String   @default("{}")
  submittedAt     DateTime @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

// --- Notification log (for audit + user notification center) ---

model NotificationLog {
  id              String   @id @default(cuid())
  userId          String?
  organizationId  String?
  // EMAIL | SMS | PUSH | IN_APP
  channel         String
  templateCode    String
  // PENDING | SENT | DELIVERED | FAILED
  status          String   @default("PENDING")
  // JSON: rendered content + provider reference
  payload         String   @default("{}")
  createdAt       DateTime @default(now())
  sentAt          DateTime?

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

// ===========================================================================
// Milestone 3 — Developer Platform, Extension Framework & Connector SDK
// ===========================================================================
// Enables third parties and internal teams to safely extend the platform without
// modifying core code. Extensions run in a sandboxed runtime with capability-
// based permissions. See docs/developer/ARCHITECTURE.md.
// ===========================================================================

// --- Publishers ---

model Publisher {
  id              String   @id @default(cuid())
  // Unique publisher handle, e.g. "eks-food", "acme-corp"
  handle          String   @unique
  name            String
  description     String?
  // PENDING | VERIFIED | SUSPENDED
  verificationStatus String @default("PENDING")
  // Ed25519 public key (base64) for signing packages
  publicKey       String?
  websiteUrl      String?
  contactEmail    String?
  ownerUserId     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  packages        Package[]
  extensions      Extension[]
}

// --- Extensions & Versions ---

model Extension {
  id              String   @id @default(cuid())
  // Unique extension identifier, e.g. "com.acme.cook-analytics"
  identifier      String   @unique
  name            String
  description     String?
  publisherId     String
  // The latest stable version id
  latestVersionId String? @unique
  // PENDING | ACTIVE | SUSPENDED | REMOVED
  status          String   @default("PENDING")
  // Visibility: PRIVATE | UNLISTED | PUBLIC (marketplace in M5)
  visibility      String   @default("PRIVATE")
  category        String?
  tags            String   @default("") // pipe-separated
  iconUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  publisher       Publisher   @relation(fields: [publisherId], references: [id])
  latestVersion   ExtensionVersion? @relation("LatestVersion", fields: [latestVersionId], references: [id])
  versions        ExtensionVersion[] @relation("ExtensionVersions")
  installations   ExtensionInstallation[]
  secrets         Secret[]
  logs            ExtensionLog[]
  runtimeHealth   RuntimeHealth[]
}

model ExtensionVersion {
  id              String   @id @default(cuid())
  extensionId     String
  version         String   // semver: 1.0.0
  // The manifest JSON (metadata, capabilities, permissions, config schema)
  manifest        String
  // SHA-256 of the package artifact
  checksum        String
  // Ed25519 signature (base64)
  signature       String?
  // Size in bytes of the package
  sizeBytes       Int
  // RELEASED | STAGED | DEPRECATED | YANKED
  status          String   @default("RELEASED")
  // Staged rollout percentage (0-100)
  rolloutPercent  Int      @default(100)
  changelog       String?
  // Compatibility range: >=1.0.0 <2.0.0
  compatRange     String
  createdAt       DateTime @default(now())
  publishedAt     DateTime?

  extension       Extension @relation("ExtensionVersions", fields: [extensionId], references: [id], onDelete: Cascade)
  latestFor       Extension? @relation("LatestVersion")
  installations   ExtensionInstallation[]
  packages        Package[]
  manifests       ExtensionManifest[] @relation("ManifestVersion")

  @@unique([extensionId, version])
  @@index([extensionId])
  @@index([status])
}

model ExtensionManifest {
  id              String   @id @default(cuid())
  versionId       String
  // Parsed manifest fields (denormalized for querying)
  name            String
  version         String
  capabilities    String   @default("[]") // JSON array
  permissions     String   @default("[]") // JSON array
  requiredAPIs    String   @default("[]") // JSON array
  requiredEvents  String   @default("[]") // JSON array
  configSchema    String   @default("{}") // JSON schema
  connectorDeps   String   @default("[]") // JSON array
  localization    String   @default("{}") // JSON
  licensing       String   @default("{}") // JSON
  compatRange     String
  // VALID | INVALID
  validationStatus String  @default("VALID")
  validationErrors String?
  createdAt       DateTime @default(now())

  extensionVersion ExtensionVersion @relation("ManifestVersion", fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

// --- Installations ---

model ExtensionInstallation {
  id              String   @id @default(cuid())
  extensionId     String
  versionId       String
  organizationId  String
  // The tenant this extension is installed for
  // PENDING | ACTIVE | SUSPENDED | REMOVED
  status          String   @default("PENDING")
  // Granted permissions (JSON array) — reviewed at install time
  grantedPermissions String @default("[]")
  // Extension configuration (JSON, validated against manifest configSchema)
  configuration   String   @default("{}")
  installedById   String
  activatedAt     DateTime?
  suspendedAt     DateTime?
  removedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  extension       Extension @relation(fields: [extensionId], references: [id])
  version         ExtensionVersion @relation(fields: [versionId], references: [id])
  connectorConfigs ConnectorConfiguration[]
  workflowExecutions WorkflowExecution[]

  @@unique([extensionId, organizationId])
  @@index([organizationId])
  @@index([status])
}

// --- Connectors ---

model ConnectorDefinition {
  id              String   @id @default(cuid())
  // Unique connector code, e.g. "payswap", "google-sheets"
  code            String   @unique
  name            String
  description     String?
  // The connector's auth schema (JSON schema for configuration)
  authSchema      String   @default("{}")
  // Whether this connector supports webhooks
  supportsWebhooks Boolean @default(false)
  // Whether this connector supports polling
  supportsPolling Boolean  @default(true)
  // Default sync interval in seconds
  defaultSyncIntervalSec Int @default(300)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  configurations  ConnectorConfiguration[]
  configurationsV2 ConnectorConfigurationV2[]
}

model ConnectorConfiguration {
  id              String   @id @default(cuid())
  connectorDefId  String
  organizationId  String
  installationId  String?
  // Display name for this config instance
  name            String
  // Encrypted auth credentials (never plaintext)
  encryptedConfig String
  // Sync cursor state (JSON: {lastSyncAt, cursor, ...})
  syncState       String   @default("{}")
  // ACTIVE | PAUSED | ERROR
  status          String   @default("ACTIVE")
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  connectorDef    ConnectorDefinition @relation(fields: [connectorDefId], references: [id])
  installation    ExtensionInstallation? @relation(fields: [installationId], references: [id])
  executions      ConnectorExecution[]

  @@index([organizationId])
  @@index([connectorDefId])
}

model ConnectorExecution {
  id              String   @id @default(cuid())
  configId        String
  // POLL | WEBHOOK | SYNC | HEALTH_CHECK
  kind            String
  // SUCCESS | FAILED | TIMEOUT | RETRYING
  status          String
  durationMs      Int
  // Number of retries attempted
  attempts        Int      @default(0)
  // Request summary (JSON, redacted)
  request         String   @default("{}")
  // Response summary (JSON, redacted)
  response        String   @default("{}")
  errorMessage     String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  config          ConnectorConfiguration @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([status])
  @@index([startedAt])
}

// --- Workflows ---

model WorkflowDefinition {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  // The workflow DSL (JSON: triggers, steps, conditions, branches)
  definition      String
  // The extension that owns this workflow (if any)
  installationId  String?
  version         Int      @default(1)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executions      WorkflowExecution[]

  @@index([organizationId])
}

model WorkflowExecution {
  id              String   @id @default(cuid())
  workflowDefId   String
  installationId  String?
  organizationId  String
  // RUNNING | COMPLETED | FAILED | CANCELLED | TIMED_OUT
  status          String   @default("RUNNING")
  // The trigger that started this execution (JSON)
  trigger         String   @default("{}")
  // Execution state (JSON: current step, branches, variables)
  state           String   @default("{}")
  // Steps completed (JSON array)
  stepsCompleted  String   @default("[]")
  // Steps failed (JSON array)
  stepsFailed     String   @default("[]")
  errorMessage    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  durationMs      Int?

  workflowDef     WorkflowDefinition @relation(fields: [workflowDefId], references: [id], onDelete: Cascade)
  installation    ExtensionInstallation? @relation(fields: [installationId], references: [id])

  @@index([workflowDefId])
  @@index([organizationId])
  @@index([status])
}

// --- Event Replay ---

model EventReplay {
  id              String   @id @default(cuid())
  organizationId  String
  // The event being replayed
  eventId         String
  eventType       String
  // DRY_RUN | EXECUTE
  mode            String
  // PENDING | RUNNING | COMPLETED | FAILED
  status          String   @default("PENDING")
  // The original event payload (JSON)
  originalPayload String   @default("{}")
  // The replay result (JSON)
  result          String   @default("{}")
  requestedById   String
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([status])
  @@index([eventType])
}

// --- Secrets ---

model Secret {
  id              String   @id @default(cuid())
  extensionId     String
  organizationId  String
  // The secret key name, e.g. "API_KEY", "DATABASE_URL"
  key             String
  // Encrypted value (AES-256-GCM, never plaintext)
  encryptedValue  String
  // Version number for rotation
  version         Int      @default(1)
  // Whether this secret is currently active
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  extension       Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@unique([extensionId, organizationId, key])
  @@index([extensionId])
  @@index([organizationId])
}

// --- Packages ---

model Package {
  id              String   @id @default(cuid())
  versionId       String
  publisherId     String
  // The artifact storage key / URL
  artifactUrl     String
  // SHA-256 checksum
  checksum        String
  // Ed25519 signature (base64)
  signature       String?
  // Size in bytes
  sizeBytes       Int
  // Compression format: tar+zstd | tar+gzip
  format          String   @default("tar+zstd")
  // Whether the signature has been verified
  signatureVerified Boolean @default(false)
  // Whether malware scan passed
  malwareScanPassed Boolean @default(false)
  // PUBLISHED | YANKED
  status          String   @default("PUBLISHED")
  createdAt       DateTime @default(now())

  version         ExtensionVersion @relation(fields: [versionId], references: [id])
  publisher       Publisher @relation(fields: [publisherId], references: [id])

  @@index([versionId])
  @@index([publisherId])
}

// --- Runtime Health & Logs ---

model RuntimeHealth {
  id              String   @id @default(cuid())
  extensionId     String
  organizationId  String
  // HEALTHY | DEGRADED | UNHEALTHY
  status          String
  // CPU usage in milliseconds (since last report)
  cpuMs           Int      @default(0)
  // Memory usage in bytes
  memoryBytes     Int      @default(0)
  // Number of active invocations
  activeInvocations Int    @default(0)
  // Error count since last report
  errorCount      Int      @default(0)
  // Average latency in ms
  avgLatencyMs    Float    @default(0)
  reportedAt      DateTime @default(now())

  extension       Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@index([extensionId])
  @@index([organizationId])
  @@index([reportedAt])
}

model ExtensionLog {
  id              String   @id @default(cuid())
  extensionId     String
  organizationId  String
  // TRACE | DEBUG | INFO | WARN | ERROR
  level           String
  message         String
  // JSON metadata
  metadata        String   @default("{}")
  // Trace ID for correlation
  traceId         String?
  createdAt       DateTime @default(now())

  extension       Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)

  @@index([extensionId])
  @@index([organizationId])
  @@index([level])
  @@index([createdAt])
}

// ===========================================================================
// Milestone 4 — Universal Connector Platform & Enterprise Integration Infrastructure
// ===========================================================================
// The integration layer through which all external systems communicate with
// Eks-Food. Provider-agnostic, isolated, auditable, resilient. See
// docs/integration/ARCHITECTURE.md.
// ===========================================================================

// --- Connector Registry (M4 expands M3 ConnectorDefinition) ---

/// A registered connector type (e.g. "payswap", "google-maps", "twilio-sms").
/// Extends the M3 ConnectorDefinition with versioning + scheduling metadata.
model ConnectorVersion {
  id              String   @id @default(cuid())
  connectorDefId  String
  version         String   // semver: 1.0.0
  // JSON: entrypoint metadata, capabilities, config schema
  manifest        String
  // SHA-256 of the package artifact
  checksum        String
  signature       String?
  sizeBytes       Int
  // RELEASED | DEPRECATED | YANKED
  status          String   @default("RELEASED")
  changelog       String?
  compatRange     String
  createdAt       DateTime @default(now())
  publishedAt     DateTime?

  @@unique([connectorDefId, version])
  @@index([connectorDefId])
  @@index([status])
}

// --- Credentials (encrypted, never plaintext) ---

model ConnectorCredential {
  id              String   @id @default(cuid())
  organizationId  String
  connectorDefId  String
  // Display name for this credential set
  name            String
  // API_KEY | OAUTH2 | JWT | BEARER | BASIC | MTLS | SIGNED | CUSTOM
  authType        String
  // Encrypted credential payload (AES-256-GCM)
  encryptedData   String
  // Version for rotation
  version         Int      @default(1)
  // Whether this credential is currently active
  active          Boolean  @default(true)
  // Optional expiration (for OAuth tokens that need refresh)
  expiresAt       DateTime?
  lastRotatedAt   DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  configurations  ConnectorConfigurationV2[]

  @@index([organizationId])
  @@index([connectorDefId])
}

// --- Connector Configurations (tenant-specific) ---

/// Replaces the M3 ConnectorConfiguration with a richer model that links
/// to credentials, schedules, and sync state. (The M3 model is kept for
/// backward compat; this is the M4 canonical one.)
model ConnectorConfigurationV2 {
  id              String   @id @default(cuid())
  organizationId  String
  connectorDefId  String
  credentialId    String? @unique
  // Display name
  name            String
  // JSON: connector-specific config (endpoints, options, etc.)
  config          String   @default("{}")
  // ACTIVE | PAUSED | ERROR | DRAFT
  status          String   @default("DRAFT")
  // Sync state (JSON: {lastSyncAt, cursor, totalRecords, ...})
  syncState       String   @default("{}")
  lastSyncAt      DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  credential      ConnectorCredential? @relation(fields: [credentialId], references: [id])
  connectorDef    ConnectorDefinition @relation(fields: [connectorDefId], references: [id])
  schedules       ConnectorSchedule[]
  syncJobs        SynchronizationJob[]
  webhookEndpoints WebhookEndpoint[]
  pollingJobs     PollingJob[]
  executions      ConnectorExecutionV2[]
  health          ConnectorHealth[]

  @@index([organizationId])
  @@index([connectorDefId])
  @@index([status])
}

// --- Executions (M4 expands M3 ConnectorExecution) ---

model ConnectorExecutionV2 {
  id              String   @id @default(cuid())
  configId        String
  // SYNC | POLL | WEBHOOK | HEALTH_CHECK | MANUAL
  kind            String
  // RUNNING | SUCCESS | FAILED | TIMEOUT | RETRYING
  status          String
  durationMs      Int
  attempts        Int      @default(0)
  // JSON: redacted request
  request         String   @default("{}")
  // JSON: redacted response
  response        String   @default("{}")
  errorMessage    String?
  // Correlation + trace IDs for observability
  correlationId   String?
  traceId         String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  config          ConnectorConfigurationV2 @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([status])
  @@index([startedAt])
}

// --- Health Monitoring ---

model ConnectorHealth {
  id              String   @id @default(cuid())
  configId        String
  // HEALTHY | DEGRADED | UNHEALTHY | OFFLINE
  status          String
  // Latency in ms (last request)
  latencyMs       Int      @default(0)
  // Error rate (0-1)
  errorRate       Float    @default(0)
  // Retry rate (0-1)
  retryRate       Float    @default(0)
  // Throughput (records/sec)
  throughput      Float    @default(0)
  // Sync lag in seconds (how far behind real-time)
  syncLagSec      Int      @default(0)
  // Availability (0-1) over the reporting window
  availability    Float    @default(1)
  reportedAt      DateTime @default(now())

  config          ConnectorConfigurationV2 @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([reportedAt])
}

// --- Scheduling ---

model ConnectorSchedule {
  id              String   @id @default(cuid())
  configId        String
  // CRON | INTERVAL | MANUAL | EVENT
  type            String
  // Cron expression (for CRON), interval in seconds (for INTERVAL), event type (for EVENT)
  expression      String
  // Whether this schedule is active
  active          Boolean  @default(true)
  // Maintenance windows / blackout periods (JSON array of {start, end})
  blackoutPeriods String   @default("[]")
  lastTriggeredAt DateTime?
  nextTriggerAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  config          ConnectorConfigurationV2 @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([active])
}

// --- Synchronization ---

model SynchronizationJob {
  id              String   @id @default(cuid())
  configId        String
  organizationId  String
  // FULL | INCREMENTAL | DELTA | BIDIRECTIONAL
  mode            String
  // PENDING | RUNNING | COMPLETED | FAILED | PAUSED | CANCELLED
  status          String   @default("PENDING")
  // Total records processed
  recordsProcessed Int     @default(0)
  recordsCreated  Int      @default(0)
  recordsUpdated  Int      @default(0)
  recordsDeleted  Int      @default(0)
  recordsFailed   Int      @default(0)
  conflicts       Int      @default(0)
  // JSON: error details for partial failures
  errors          String   @default("[]")
  errorMessage    String?
  // Correlation ID for tracing
  correlationId   String?
  startedAt       DateTime?
  completedAt     DateTime?
  durationMs      Int?
  createdAt       DateTime @default(now())

  config          ConnectorConfigurationV2 @relation(fields: [configId], references: [id], onDelete: Cascade)
  checkpoints     SynchronizationCheckpoint[]

  @@index([configId])
  @@index([organizationId])
  @@index([status])
}

model SynchronizationCheckpoint {
  id              String   @id @default(cuid())
  syncJobId       String
  // The resource being synced (e.g. "bookings", "customers")
  resource        String
  // The cursor position (opaque to the platform; connector-specific)
  cursor          String?
  // Records synced up to this checkpoint
  recordsSynced   Int      @default(0)
  // Timestamp of the last record synced
  lastRecordAt    DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  syncJob         SynchronizationJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@unique([syncJobId, resource])
  @@index([syncJobId])
}

// --- Webhooks ---

model WebhookEndpoint {
  id              String   @id @default(cuid())
  configId        String
  organizationId  String
  // The URL to deliver to (for outbound) or the path to receive on (for inbound)
  url             String
  // The event types this endpoint subscribes to (JSON array; empty = all)
  eventTypes      String   @default("[]")
  // HMAC-SHA256 secret for signature verification
  signingSecret   String
  // Whether this endpoint is active
  active          Boolean  @default(true)
  // Verification status (for inbound: challenge-response)
  verified        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  config          ConnectorConfigurationV2 @relation(fields: [configId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([configId])
  @@index([organizationId])
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  endpointId      String
  // The event being delivered
  eventId         String
  eventType       String
  // The payload (JSON)
  payload         String   @default("{}")
  // The computed HMAC-SHA256 signature
  signature       String
  // PENDING | DELIVERED | FAILED | RETRYING | DEAD_LETTERED
  status          String   @default("PENDING")
  // HTTP response status code
  responseStatus  Int?
  // Response body (truncated)
  responseBody    String?
  attempts        Int      @default(0)
  errorMessage    String?
  deliveredAt     DateTime?
  firstAttemptAt  DateTime @default(now())
  lastAttemptAt   DateTime?

  endpoint        WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([status])
  @@index([eventType])
}

// --- Polling ---

model PollingJob {
  id              String   @id @default(cuid())
  configId        String
  // The resource to poll (e.g. "orders", "inventory")
  resource        String
  // Polling interval in seconds
  intervalSec     Int      @default(300)
  // Whether adaptive polling is enabled
  adaptive        Boolean  @default(false)
  // Last cursor (for incremental polling)
  lastCursor      String?
  // Records fetched in the last poll
  lastRecordCount Int      @default(0)
  // ACTIVE | PAUSED | ERROR
  status          String   @default("ACTIVE")
  lastPollAt      DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  config          ConnectorConfigurationV2 @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([status])
}

// --- Schema Registry ---

model SchemaDefinition {
  id              String   @id @default(cuid())
  // The schema's unique identifier (e.g. "booking.created", "customer.updated")
  identifier      String   @unique
  name            String
  description     String?
  // JSON | AVRO | PROTOBUF | XML
  format          String   @default("JSON")
  // The latest version id
  latestVersionId String? @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  versions        SchemaVersion[]
  latestVersion   SchemaVersion?  @relation("LatestSchemaVersion", fields: [latestVersionId], references: [id])
}

model SchemaVersion {
  id              String   @id @default(cuid())
  schemaDefId     String
  version         String   // semver: 1.0.0
  // The schema definition (JSON Schema, Avro schema, etc.)
  schema          String
  // BACKWARD | FORWARD | FULL | NONE
  compatibility   String   @default("BACKWARD")
  // Whether this version is active
  active          Boolean  @default(true)
  changelog       String?
  createdAt       DateTime @default(now())

  schemaDef       SchemaDefinition @relation(fields: [schemaDefId], references: [id], onDelete: Cascade)
  latestFor       SchemaDefinition? @relation("LatestSchemaVersion")
  mappingsAsSource MappingTemplate[] @relation("MappingSource")
  mappingsAsTarget MappingTemplate[] @relation("MappingTarget")

  @@unique([schemaDefId, version])
  @@index([schemaDefId])
}

// --- Mapping & Transformation ---

model MappingTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String?
  // The source schema version
  sourceSchemaVersionId String
  // The target schema version
  targetSchemaVersionId String
  // JSON: field mapping rules [{source, target, transform?, required?}]
  rules           String   @default("[]")
  // Whether this template is active
  active          Boolean  @default(true)
  // Version of this template
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sourceSchemaVersion SchemaVersion @relation("MappingSource", fields: [sourceSchemaVersionId], references: [id])
  targetSchemaVersion SchemaVersion @relation("MappingTarget", fields: [targetSchemaVersionId], references: [id])

  @@index([sourceSchemaVersionId])
  @@index([targetSchemaVersionId])
}

model TransformationRule {
  id              String   @id @default(cuid())
  name            String
  description     String?
  // JSON | XML | CSV | CUSTOM
  inputFormat     String   @default("JSON")
  outputFormat    String   @default("JSON")
  // The transformation expression (JSONata, JMESPath, or custom)
  expression      String
  // Whether this rule is active
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
}

// --- Retry & Rate Limit Policies ---

model RetryPolicy {
  id              String   @id @default(cuid())
  name            String
  // Max attempts
  maxAttempts     Int      @default(3)
  // Base delay in ms
  baseDelayMs     Int      @default(100)
  // Backoff multiplier
  multiplier      Float    @default(2)
  // Max delay cap
  maxDelayMs      Int      @default(5000)
  // Jitter: NONE | FULL | EQUAL
  jitter          String   @default("FULL")
  // Retry budget (max retries per window)
  budget          Int      @default(100)
  // Budget window in ms
  budgetWindowMs  Int      @default(60000)
  // Whether to enable circuit breaker
  circuitBreaker  Boolean  @default(true)
  // Circuit breaker threshold
  cbThreshold     Int      @default(5)
  // Circuit breaker cooldown
  cbCooldownMs    Int      @default(30000)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
}

model RateLimitPolicy {
  id              String   @id @default(cuid())
  name            String
  // Token bucket capacity
  capacity        Int      @default(100)
  // Refill rate (tokens per second)
  refillRate      Float    @default(10)
  // Burst limit (max requests in a burst)
  burstLimit      Int      @default(20)
  // Concurrency limit (max simultaneous requests)
  concurrencyLimit Int     @default(10)
  // Whether adaptive throttling is enabled
  adaptive        Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
}

// --- Secret References (links to M3 Secret model, with connector scope) ---

model SecretReference {
  id              String   @id @default(cuid())
  organizationId  String
  connectorDefId  String
  // The secret key name (e.g. "API_KEY", "OAUTH_CLIENT_SECRET")
  key             String
  // Reference to the M3 Secret model (by key, not raw value)
  secretExtensionId String?
  // Optional expiration
  expiresAt       DateTime?
  // Whether this reference is active
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, connectorDefId, key])
  @@index([organizationId])
  @@index([connectorDefId])
}

// ===========================================================================
// Milestone 5 — Production Connector Implementations & External Service Integrations
// ===========================================================================
// Production connectors built on the M4 Universal Connector Platform. Provider-
// agnostic, with a selection engine, normalization, failover, and caching.
// See docs/connectors/PROVIDER_DEVELOPMENT.md.
// ===========================================================================

// --- Provider Registry ---

model ExternalProvider {
  id              String   @id @default(cuid())
  // MAPS | WEATHER | CALENDAR | GOVERNMENT | RESTAURANT | PROCUREMENT | MERCHANT | NOTIFICATIONS | COMMUNICATIONS | IDENTITY
  category        String
  // The provider code, e.g. "google-maps", "openweather", "google-calendar"
  code            String
  name            String
  description     String?
  // The semantic version of the provider adapter
  version         String   @default("1.0.0")
  // ACTIVE | INACTIVE | DEPRECATED
  status          String   @default("ACTIVE")
  // Default weight for provider selection (higher = preferred)
  weight          Int      @default(100)
  // Whether this provider supports failover
  supportsFailover Boolean @default(true)
  // JSON: supported capabilities (e.g. ["geocoding", "routing", "places"])
  capabilities    String   @default("[]")
  // JSON: supported regions (e.g. ["GH", "NG", "global"])
  regions         String   @default("[]")
  // JSON: rate limits (per-second, per-day)
  rateLimits      String   @default("{}")
  // JSON: pricing (cost per 1k calls)
  pricing         String   @default("{}")
  publisherId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  configurations  ProviderConfiguration[]
  health          ProviderHealth[]
  capabilities2   ProviderCapability[]

  @@unique([category, code])
  @@index([category])
  @@index([status])
}

model ProviderConfiguration {
  id              String   @id @default(cuid())
  organizationId  String
  providerId      String
  // Display name
  name            String
  // JSON: provider-specific config
  config          String   @default("{}")
  // ACTIVE | PAUSED | ERROR
  status          String   @default("ACTIVE")
  // The credential ID (links to ConnectorCredential or ProviderCredential)
  credentialId    String?
  // JSON: tenant-specific overrides (weight, region preference, etc.)
  tenantOverrides String   @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider        ExternalProvider @relation(fields: [providerId], references: [id])
  credential      ProviderCredential? @relation(fields: [credentialId], references: [id])

  @@index([organizationId])
  @@index([providerId])
  @@index([status])
}

model ProviderCredential {
  id              String   @id @default(cuid())
  organizationId  String
  providerId      String
  name            String
  // API_KEY | OAUTH2 | BEARER | BASIC | MTLS | SIGNED | CUSTOM
  authType        String
  // Encrypted credential payload (AES-256-GCM)
  encryptedData   String
  version         Int      @default(1)
  active          Boolean  @default(true)
  expiresAt       DateTime?
  lastRotatedAt   DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  configurations  ProviderConfiguration[]

  @@index([organizationId])
  @@index([providerId])
}

model ProviderHealth {
  id              String   @id @default(cuid())
  providerId      String
  // HEALTHY | DEGRADED | UNHEALTHY | OFFLINE
  status          String
  // Health score (0-100, used by the selection engine)
  score           Int      @default(100)
  latencyMs       Int      @default(0)
  errorRate       Float    @default(0)
  successRate     Float    @default(1)
  // Number of consecutive failures (for circuit breaker)
  consecutiveFailures Int  @default(0)
  reportedAt      DateTime @default(now())

  provider        ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([reportedAt])
}

model ProviderCapability {
  id              String   @id @default(cuid())
  providerId      String
  // e.g. "geocoding", "routing", "current_weather", "read_events"
  code            String
  // Whether this capability is currently supported
  supported       Boolean  @default(true)
  // JSON: capability-specific limits or config
  metadata        String   @default("{}")
  createdAt       DateTime @default(now())

  provider        ExternalProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, code])
  @@index([providerId])
}

model ProviderRegion {
  id              String   @id @default(cuid())
  providerId      String
  // ISO country code or "global"
  region          String
  // Whether the provider is available in this region
  available       Boolean  @default(true)
  // Region-specific latency in ms
  latencyMs       Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([providerId, region])
  @@index([providerId])
}

// --- Caching ---

model ConnectorCache {
  id              String   @id @default(cuid())
  organizationId  String
  providerId      String
  // The cache key
  key             String
  // The cached value (JSON)
  value           String
  // TTL in seconds
  ttlSec          Int
  // Whether this entry is stale (for stale-while-revalidate)
  stale           Boolean  @default(false)
  // Hit count (for hot-key analysis)
  hitCount        Int      @default(0)
  createdAt       DateTime @default(now())
  expiresAt       DateTime
  lastAccessedAt  DateTime @default(now())

  @@unique([organizationId, providerId, key])
  @@index([organizationId, providerId])
  @@index([expiresAt])
}

// --- Synchronization History ---

model SynchronizationHistory {
  id              String   @id @default(cuid())
  organizationId  String
  providerId      String
  configId        String?
  // The resource synced
  resource        String
  // FULL | INCREMENTAL | DELTA
  mode            String
  // COMPLETED | FAILED | PARTIAL
  status          String
  recordsSynced   Int      @default(0)
  durationMs      Int      @default(0)
  // The cursor for the next sync
  nextCursor      String?
  errorMessage    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([organizationId, providerId])
  @@index([status])
  @@index([startedAt])
}

// --- Category-Specific Connections ---

model MapProvider {
  id              String   @id @default(cuid())
  organizationId  String
  providerCode    String   // google-maps | here | mapbox | openstreetmap
  apiKey           String   // encrypted
  active          Boolean  @default(true)
  // Preferred routing profile: driving | walking | cycling | transit
  routingProfile  String   @default("driving")
  // Whether traffic-aware routing is enabled
  trafficAware    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model WeatherProvider {
  id              String   @id @default(cuid())
  organizationId  String
  providerCode    String   // openweather | weatherapi | accuweather | open-meteo
  apiKey           String   // encrypted
  active          Boolean  @default(true)
  // Default location for weather queries
  defaultLat      Float?
  defaultLng      Float?
  // Cache TTL in seconds for forecasts
  cacheTtlSec     Int      @default(600)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model CalendarConnection {
  id              String   @id @default(cuid())
  organizationId  String
  providerCode    String   // google-calendar | outlook | caldav
  // The external calendar ID
  externalCalendarId String
  // Encrypted OAuth tokens or CalDAV credentials
  encryptedTokens String
  // The last sync cursor (for incremental sync)
  syncCursor      String?
  active          Boolean  @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model RestaurantConnection {
  id              String   @id @default(cuid())
  organizationId  String
  providerCode    String   // square | toast | lightspeed | clover | generic-pos
  restaurantId    String
  // Encrypted API credentials
  encryptedCreds  String
  // POS | RESERVATIONS | KITCHEN | MENU
  systemType      String
  active          Boolean  @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model ProcurementConnection {
  id              String   @id @default(cuid())
  organizationId  String
  providerCode    String   // sysco | usfoods | metro | csv-sftp | edi | local
  supplierId      String
  // Encrypted credentials
  encryptedCreds  String
  // The sync interval in seconds
  syncIntervalSec Int      @default(3600)
  active          Boolean  @default(true)
  lastSyncAt      DateTime?
  lastCatalogHash String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model MerchantConnection {
  id              String   @id @default(cuid())
  organizationId  String
  providerCode    String   // corporate-meals | catering | workplace-ordering
  merchantId      String
  // Encrypted credentials
  encryptedCreds  String
  // JSON: contract metadata
  contract        String   @default("{}")
  active          Boolean  @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model GovernmentConnection {
  id              String   @id @default(cuid())
  organizationId  String
  providerCode    String   // gh-fda | ng-nafdac | ke-kebs | za-sabs
  // The verification type
  verificationType String   // BUSINESS_REG | FOOD_LICENSE | FOOD_HANDLER_CERT | INSPECTION | TAX_REG
  // Encrypted credentials
  encryptedCreds  String
  active          Boolean  @default(true)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model NotificationProvider {
  id              String   @id @default(cuid())
  organizationId  String
  providerCode    String   // sendgrid | mailgun | twilio | messagebird | fcm | apns
  // EMAIL | SMS | PUSH | IN_APP
  channel         String
  // Encrypted credentials
  encryptedCreds  String
  active          Boolean  @default(true)
  // Whether this is the default provider for the channel
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([channel])
}

model CommunicationProvider {
  id              String   @id @default(cuid())
  organizationId  String
  providerCode    String   // twilio-voice | vonage | slack | teams | whatsapp
  // VOICE | CHAT | EMAIL | SMS
  channel         String
  // Encrypted credentials
  encryptedCreds  String
  active          Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([channel])
}

// ===========================================================================
// Milestone 6 — Core Food Domain, Canonical Data Model & Food Intelligence Graph
// ===========================================================================
// The canonical domain model + Food Intelligence Graph. Every subsystem reasons
// over this shared model. See docs/food-domain/DOMAIN_MODEL_REFERENCE.md.
// ===========================================================================

// --- Geographic Hierarchy ---

model Country {
  id        String   @id @default(cuid())
  code      String   @unique // ISO 3166-1 alpha-2: GH, NG, KE, ZA
  name      String
  nameLocalized String @default("{}") // JSON: {en, tw, ha, ...}
  currency  String   @default("GHS")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  regions     GeoRegion[]
  cities      City[]
  neighborhoods Neighborhood[]
}

model GeoRegion {
  id        String   @id @default(cuid())
  countryId String
  code      String   // e.g. "greater-accra"
  name      String
  nameLocalized String @default("{}")
  type      String   @default("PROVINCE") // PROVINCE | STATE | TERRITORY
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country      Country @relation(fields: [countryId], references: [id])
  cities       City[]

  @@unique([countryId, code])
  @@index([countryId])
}

model City {
  id        String   @id @default(cuid())
  countryId String
  regionId  String?
  code      String
  name      String
  nameLocalized String @default("{}")
  lat       Float?
  lng       Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country        Country @relation(fields: [countryId], references: [id])
  region         GeoRegion? @relation(fields: [regionId], references: [id])
  neighborhoods  Neighborhood[]

  @@unique([countryId, code])
  @@index([countryId])
  @@index([regionId])
}

model Neighborhood {
  id        String   @id @default(cuid())
  cityId    String
  countryId String
  name      String
  nameLocalized String @default("{}")
  // Delivery zone metadata
  deliveryZoneCode String?
  postalCode String?
  lat       Float?
  lng       Float?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  city     City     @relation(fields: [cityId], references: [id])
  country  Country  @relation(fields: [countryId], references: [id])

  @@index([cityId])
  @@index([countryId])
}

// --- Customer Domain ---

model Household {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  // JSON: { address, lat, lng, neighborhoodId }
  address         String   @default("{}")
  // ACTIVE | INACTIVE
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  members         CustomerProfile[]

  @@index([organizationId])
}

model CustomerProfile {
  id              String   @id @default(cuid())
  organizationId  String
  householdId     String?
  userId          String?
  name            String
  email           String?
  phone           String?
  // JSON: dietary preferences (vegan, vegetarian, etc.)
  dietaryPrefs    String   @default("[]")
  // JSON: allergies
  allergies       String   @default("[]")
  // JSON: favorite cuisines
  favoriteCuisines String  @default("[]")
  // JSON: favorite meals
  favoriteMeals   String   @default("[]")
  // JSON: nutrition goals
  nutritionGoals  String   @default("{}")
  // JSON: cooking preferences
  cookingPrefs    String   @default("{}")
  // ACTIVE | INACTIVE
  status          String   @default("ACTIVE")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  household       Household? @relation(fields: [householdId], references: [id])

  @@index([organizationId])
  @@index([householdId])
}

// --- Cook Domain ---

model CookProfile {
  id              String   @id @default(cuid())
  organizationId  String
  userId          String?
  name            String
  bio             String   @default("")
  // JSON: cuisine specialties
  cuisines        String   @default("[]")
  // JSON: languages
  languages       String   @default("[]")
  // JSON: service areas (neighborhood IDs)
  serviceAreas    String   @default("[]")
  // JSON: working hours
  workingHours    String   @default("{}")
  // JSON: kitchen associations
  kitchenAssociations String @default("[]")
  // JSON: experience
  experience      String   @default("{}")
  // JSON: qualifications
  qualifications  String   @default("[]")
  // JSON: availability profile
  availability    String   @default("{}")
  // PENDING | ACTIVE | SUSPENDED | INACTIVE
  status          String   @default("PENDING")
  rating          Float    @default(5.0)
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([organizationId])
  @@index([status])
}

// --- Restaurant Domain ---

model Restaurant {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  // JSON: locations (multiple)
  locations       String   @default("[]")
  // JSON: operating hours
  operatingHours  String   @default("{}")
  // JSON: kitchen capacity metadata
  kitchenCapacity String   @default("{}")
  // JSON: cuisines
  cuisines        String   @default("[]")
  // JSON: seating
  seating         String   @default("{}")
  // JSON: facilities
  facilities      String   @default("[]")
  // JSON: brand relationships
  brands          String   @default("[]")
  // franchise parent (if part of a franchise)
  franchiseParentId String?
  // PENDING | ACTIVE | SUSPENDED | INACTIVE
  status          String   @default("PENDING")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  menus           Menu[]

  @@index([organizationId])
  @@index([status])
}

// --- Kitchen Domain ---

model Kitchen {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  // COMMERCIAL | SHARED | HOME | CLOUD | EVENT
  type            String   @default("COMMERCIAL")
  // JSON: capacity { stations, maxCooks, mealsPerHour }
  capacity        String   @default("{}")
  // JSON: equipment IDs
  equipment       String   @default("[]")
  // JSON: certifications
  certifications  String   @default("[]")
  // JSON: ownership
  ownership       String   @default("{}")
  // JSON: utilization metadata
  utilization     String   @default("{}")
  // JSON: availability
  availability    String   @default("{}")
  // JSON: facilities
  facilities      String   @default("[]")
  // JSON: location { address, lat, lng }
  location        String   @default("{}")
  // ACTIVE | INACTIVE | MAINTENANCE
  status          String   @default("ACTIVE")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([organizationId])
  @@index([type])
  @@index([status])
}

// --- Ingredient Domain ---

model Ingredient {
  id              String   @id @default(cuid())
  organizationId  String?
  // Globally unique ingredient code (e.g. "ING-RICE-001")
  code            String   @unique
  name            String
  nameLocalized   String   @default("{}") // JSON: {en, tw, ha, ...}
  description     String?
  // JSON: categories
  categories      String   @default("[]")
  // JSON: units (kg, g, L, ml, piece, bunch)
  units           String   @default("[]")
  // JSON: nutrition per 100g
  nutrition       String   @default("{}")
  // JSON: allergens
  allergens       String   @default("[]")
  // Shelf life in days
  shelfLifeDays   Int?
  // JSON: storage requirements
  storageRequirements String @default("{}")
  // JSON: substitutions (ingredient IDs)
  substitutions   String   @default("[]")
  // JSON: seasonality { months: [1,2,3...] }
  seasonality     String   @default("{}")
  // JSON: origin
  origin          String   @default("{}")
  // JSON: certifications
  certifications  String   @default("[]")
  // ACTIVE | INACTIVE
  status          String   @default("ACTIVE")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  recipeIngredients RecipeIngredient[]

  @@index([organizationId])
  @@index([status])
}

// --- Recipe Domain ---

model Recipe {
  id              String   @id @default(cuid())
  organizationId  String?
  name            String
  nameLocalized   String   @default("{}")
  description     String?
  // JSON: preparation steps
  steps           String   @default("[]")
  // JSON: nutritional analysis
  nutrition       String   @default("{}")
  // JSON: allergens
  allergens       String   @default("[]")
  // Preparation time in minutes
  prepTimeMin     Int      @default(30)
  // Cook time in minutes
  cookTimeMin     Int      @default(30)
  // JSON: equipment requirements
  equipmentRequired String  @default("[]")
  // Default serving size
  servingSize     Int      @default(4)
  // JSON: variations
  variations      String   @default("[]")
  // DRAFT | PUBLISHED | ARCHIVED
  status          String   @default("DRAFT")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  ingredients     RecipeIngredient[]
  menuItems       MenuItem[]

  @@index([organizationId])
  @@index([status])
}

model RecipeIngredient {
  id              String   @id @default(cuid())
  recipeId        String
  ingredientId    String
  // Quantity in the specified unit
  quantity        Float
  unit            String   @default("g")
  // Optional preparation note (e.g. "diced", "marinated")
  preparation     String?
  createdAt       DateTime @default(now())

  recipe          Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}

// --- Menu Domain ---

model Menu {
  id              String   @id @default(cuid())
  restaurantId    String
  name            String
  description     String?
  // JSON: seasonal availability
  seasonal        String   @default("{}")
  // ACTIVE | INACTIVE
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items           MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id              String   @id @default(cuid())
  menuId          String
  recipeId        String?
  name            String
  description     String?
  // Price reference (no pricing logic — just the reference value)
  priceReference Float?
  currency        String   @default("GHS")
  // JSON: availability
  available       Boolean  @default(true)
  // JSON: nutritional information
  nutrition       String   @default("{}")
  // Preparation estimate in minutes
  prepEstimateMin Int?
  // JSON: dietary labels
  dietaryLabels   String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menu            Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  recipe          Recipe?  @relation(fields: [recipeId], references: [id])

  @@index([menuId])
  @@index([recipeId])
}

// --- Inventory Domain ---

model Inventory {
  id              String   @id @default(cuid())
  organizationId  String
  ingredientId    String?
  name            String
  // JSON: storage location
  storageLocation String   @default("{}")
  // Current quantity
  quantity        Float    @default(0)
  unit            String   @default("g")
  // Reorder level
  reorderLevel    Float    @default(0)
  // JSON: replenishment metadata
  replenishment   String   @default("{}")
  // ACTIVE | INACTIVE
  status          String   @default("ACTIVE")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  batches         InventoryBatch[]

  @@index([organizationId])
  @@index([ingredientId])
}

model InventoryBatch {
  id              String   @id @default(cuid())
  inventoryId     String
  // Batch number for traceability
  batchNumber     String
  // Initial quantity
  initialQuantity Float
  // Remaining quantity
  remainingQuantity Float
  unit            String   @default("g")
  // Expiration date
  expiresAt       DateTime?
  // JSON: storage conditions
  storageConditions String @default("{}")
  // RECEIVED | IN_USE | DEPLETED | EXPIRED | DISCARDED
  status          String   @default("RECEIVED")
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  inventory       Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([status])
  @@index([expiresAt])
}

// --- Equipment Domain ---

model Equipment {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  description     String?
  // JSON: capacity
  capacity        String   @default("{}")
  // JSON: maintenance history
  maintenanceHistory String @default("[]")
  // JSON: certifications
  certifications  String   @default("[]")
  // JSON: availability
  availability    String   @default("{}")
  // JSON: ownership
  ownership       String   @default("{}")
  // ACTIVE | INACTIVE | MAINTENANCE
  status          String   @default("ACTIVE")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([organizationId])
  @@index([status])
}

// --- Vehicle Domain ---

model Vehicle {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  // DELIVERY | REFRIGERATED | CARGO
  type            String   @default("DELIVERY")
  // Refrigeration capability
  refrigerated    Boolean  @default(false)
  // Cargo capacity in kg
  cargoCapacityKg Float    @default(500)
  // JSON: certifications
  certifications  String   @default("[]")
  // JSON: ownership
  ownership       String   @default("{}")
  // JSON: maintenance history
  maintenanceHistory String @default("[]")
  // ACTIVE | INACTIVE | MAINTENANCE
  status          String   @default("ACTIVE")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([organizationId])
  @@index([status])
}

// --- Supplier Domain ---

model Supplier {
  id              String   @id @default(cuid())
  organizationId  String?
  name            String
  description     String?
  // JSON: product catalog (ingredient codes)
  productCatalog  String   @default("[]")
  // JSON: certifications
  certifications  String   @default("[]")
  // JSON: operating regions
  operatingRegions String  @default("[]")
  // Lead time in days
  leadTimeDays    Int      @default(7)
  // JSON: delivery capabilities
  deliveryCapabilities String @default("{}")
  // ACTIVE | INACTIVE
  status          String   @default("ACTIVE")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([organizationId])
  @@index([status])
}

// --- Vendor Domain ---

model Vendor {
  id              String   @id @default(cuid())
  organizationId  String?
  name            String
  description     String?
  // MARKETPLACE | SPECIALTY | FARMER | WHOLESALER | DISTRIBUTOR
  type            String   @default("MARKETPLACE")
  // JSON: products
  products        String   @default("[]")
  // JSON: certifications
  certifications  String   @default("[]")
  // JSON: operating regions
  operatingRegions String  @default("[]")
  // ACTIVE | INACTIVE
  status          String   @default("ACTIVE")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  @@index([organizationId])
  @@index([type])
  @@index([status])
}

// --- Certification Domain ---

model FoodCertification {
  id              String   @id @default(cuid())
  organizationId  String?
  title           String
  issuer          String
  // FOOD_SAFETY | HYGIENE | BUSINESS_LICENSE | PROFESSIONAL | OTHER
  type            String   @default("FOOD_SAFETY")
  // The entity this certification applies to (polymorphic)
  entityType      String   // COOK | KITCHEN | RESTAURANT | SUPPLIER | VENDOR
  entityId        String
  issuedAt        DateTime?
  expiresAt       DateTime?
  // JSON: issuing authority metadata
  issuingAuthority String  @default("{}")
  // PENDING | VERIFIED | EXPIRED | REVOKED
  status          String   @default("PENDING")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([status])
}

// --- Inspection Domain ---

model FoodInspection {
  id              String   @id @default(cuid())
  organizationId  String
  // The entity being inspected
  entityType      String   // KITCHEN | RESTAURANT | COOK | SUPPLIER
  entityId        String
  // SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  status          String   @default("SCHEDULED")
  // JSON: findings
  findings        String   @default("[]")
  // JSON: violations
  violations      String   @default("[]")
  // JSON: corrective actions
  correctiveActions String  @default("[]")
  // PASS | FAIL | PENDING_REVIEW
  outcome         String?
  // Follow-up inspection ID (if required)
  followUpId      String?
  scheduledFor    DateTime
  completedAt     DateTime?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([status])
}

// --- Food Safety Domain ---

model FoodSafetyIncident {
  id              String   @id @default(cuid())
  organizationId  String
  title           String
  description     String?
  // INCIDENT | RECALL | CONTAMINATION | COMPLAINT
  type            String   @default("INCIDENT")
  // LOW | MEDIUM | HIGH | CRITICAL
  severity        String   @default("LOW")
  // The affected entity (polymorphic)
  entityType      String?
  entityId        String?
  // JSON: root cause metadata
  rootCause       String   @default("{}")
  // JSON: corrective actions
  correctiveActions String  @default("[]")
  // OPEN | INVESTIGATING | RESOLVED | CLOSED
  status          String   @default("OPEN")
  reportedAt      DateTime @default(now())
  resolvedAt      DateTime?
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([severity])
}

// --- Nutrition Domain ---

model NutritionProfile {
  id              String   @id @default(cuid())
  organizationId  String?
  name            String
  // JSON: macro nutrients { calories, protein, carbs, fat, fiber }
  macros          String   @default("{}")
  // JSON: micro nutrients { vitamins, minerals }
  micros          String   @default("{}")
  // JSON: dietary restrictions
  dietaryRestrictions String @default("[]")
  // JSON: allergens
  allergens       String   @default("[]")
  // JSON: nutrition labels
  labels          String   @default("[]")
  // JSON: serving calculations
  servingCalculations String @default("{}")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

// --- Food Intelligence Graph ---

model GraphNode {
  id              String   @id @default(cuid())
  // The entity type (CUSTOMER, COOK, KITCHEN, INGREDIENT, RECIPE, etc.)
  entityType      String
  // The entity ID
  entityId        String
  // JSON: snapshot of entity data for quick access
  data            String   @default("{}")
  // Organization scope (null = global)
  organizationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  edgesFrom       GraphEdge[] @relation("EdgeFrom")
  edgesTo         GraphEdge[] @relation("EdgeTo")

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([organizationId])
}

model GraphEdge {
  id              String   @id @default(cuid())
  fromNodeId      String
  toNodeId        String
  // The relationship type (member_of, works_at, contains, supplies, inspects, certified_by, etc.)
  type            String
  // JSON: relationship metadata
  metadata        String   @default("{}")
  // Temporal: when this relationship started
  validFrom       DateTime @default(now())
  // Temporal: when this relationship ended (null = active)
  validTo         DateTime?
  // Edge weight (for weighted path queries)
  weight          Float    @default(1)
  createdAt       DateTime @default(now())

  fromNode        GraphNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode          GraphNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, type])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([type])
}

// --- Entity Versioning ---

model EntityVersion {
  id              String   @id @default(cuid())
  organizationId  String?
  entityType      String
  entityId        String
  version         Int
  // JSON: snapshot of the entity at this version
  snapshot        String   @default("{}")
  // Who made the change
  changedById     String?
  // What kind of change
  changeType      String   // CREATE | UPDATE | DELETE | IMPORT | EXPORT
  // JSON: diff (field-level changes)
  diff            String   @default("{}")
  createdAt       DateTime @default(now())

  @@index([entityType, entityId])
  @@index([organizationId])
  @@index([createdAt])
}

// --- Relationships (simplified — mirrors GraphEdge for direct querying) ---

model Relationship {
  id              String   @id @default(cuid())
  organizationId  String?
  // The source entity
  fromEntityType  String
  fromEntityId    String
  // The target entity
  toEntityType    String
  toEntityId      String
  // The relationship type
  type            String
  // JSON: metadata
  metadata        String   @default("{}")
  validFrom       DateTime @default(now())
  validTo         DateTime?
  createdAt       DateTime @default(now())

  @@index([fromEntityType, fromEntityId])
  @@index([toEntityType, toEntityId])
  @@index([type])
  @@index([organizationId])
}

// ===========================================================================
// Milestone 7 — Food Catalog, Recipe, Menu, Inventory & Nutritional Intelligence
// ===========================================================================
// The operational Food Intelligence Platform. Transforms the canonical domain
// model into production catalog management, recipes, menus, inventory, nutrition.
// See docs/fims/CATALOG_ARCHITECTURE.md.
// ===========================================================================

// --- Food Catalog ---

model FoodCatalog {
  id              String   @id @default(cuid())
  organizationId  String?
  // Globally unique catalog code (e.g. "FC-ING-001")
  code            String   @unique
  name            String
  nameLocalized   String   @default("{}")
  description     String?
  // INGREDIENT | PREPARED_FOOD | BEVERAGE | PACKAGED | MEAL_KIT | SPICE | CONDIMENT | ADDITIVE | ALLERGEN
  itemType        String   @default("INGREDIENT")
  // JSON: aliases (alternative names)
  aliases         String   @default("[]")
  // JSON: image URLs
  images          String   @default("[]")
  // Barcode (EAN/UPC)
  barcode         String?
  // SKU reference
  sku             String?
  // Supplier reference
  supplierId      String?
  // JSON: categories (taxonomy IDs)
  categories      String   @default("[]")
  // JSON: extensible metadata
  metadata        String   @default("{}")
  // DRAFT | ACTIVE | DISCONTINUED
  status          String   @default("DRAFT")
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  variants        IngredientVariant[]
  nutritionFacts  NutritionFact[]
  imports         CatalogImportRow[]

  @@index([organizationId])
  @@index([itemType])
  @@index([status])
  @@index([barcode])
  @@index([sku])
}

model FoodCategory {
  id              String   @id @default(cuid())
  // The parent category ID (null = root)
  parentId        String?
  code            String   @unique
  name            String
  nameLocalized   String   @default("{}")
  // CATEGORY | SUBCATEGORY | CUISINE | MEAL_TYPE | INGREDIENT_FAMILY | DIETARY | PREPARATION | TECHNIQUE
  type            String   @default("CATEGORY")
  description     String?
  sortOrder       Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([parentId])
  @@index([type])
}

model IngredientVariant {
  id              String   @id @default(cuid())
  catalogId       String
  name            String
  // JSON: variant attributes (size, color, packaging, etc.)
  attributes      String   @default("{}")
  // JSON: nutritional differences from base
  nutritionDiff   String   @default("{}")
  // JSON: price reference
  priceRef        String   @default("{}")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalog         FoodCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  @@index([catalogId])
}

model IngredientAlias {
  id              String   @id @default(cuid())
  name            String
  // The canonical ingredient name this alias maps to
  canonicalName   String
  // Language code
  language        String   @default("en")
  // Region (e.g. "GH", "NG")
  region          String?
  createdAt       DateTime @default(now())

  @@unique([name, language])
  @@index([canonicalName])
}

// --- Recipe Platform (extends M6 Recipe) ---

model RecipeVersion {
  id              String   @id @default(cuid())
  recipeId        String
  version         Int
  // JSON: full recipe snapshot at this version
  snapshot        String   @default("{}")
  // DRAFT | IN_REVIEW | PUBLISHED | ARCHIVED
  status          String   @default("DRAFT")
  // Who created this version
  authoredById    String?
  // Who approved/published
  approvedById    String?
  changelog       String?
  publishedAt     DateTime?
  createdAt       DateTime @default(now())

  stages          RecipeStage[]

  @@unique([recipeId, version])
  @@index([recipeId])
  @@index([status])
}

model RecipeStage {
  id              String   @id @default(cuid())
  versionId       String
  name            String
  // PREP | COOK | COOL | REST | CLEANUP | PLATE
  type            String   @default("PREP")
  sortOrder       Int      @default(0)
  // Estimated time for this stage in minutes
  estimatedMin    Int      @default(0)
  createdAt       DateTime @default(now())

  version         RecipeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  instructions    RecipeInstruction[]

  @@index([versionId])
}

model RecipeInstruction {
  id              String   @id @default(cuid())
  stageId         String
  sortOrder       Int      @default(0)
  instruction     String
  // JSON: required equipment
  equipment       String   @default("[]")
  // JSON: required ingredients for this step
  ingredients     String   @default("[]")
  // Estimated time for this instruction in minutes
  estimatedMin    Int?
  createdAt       DateTime @default(now())

  stage           RecipeStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@index([stageId])
}

// --- Nutritional Intelligence ---

model NutritionFact {
  id              String   @id @default(cuid())
  // Polymorphic: links to FoodCatalog or Recipe
  entityType      String   // CATALOG_ITEM | RECIPE
  entityId        String
  catalogId       String?
  // Per 100g or per serving
  perAmount       Float    @default(100)
  perUnit         String   @default("g")
  // Macros
  calories        Float    @default(0)
  protein         Float    @default(0)
  carbohydrates   Float    @default(0)
  fat             Float    @default(0)
  fiber           Float    @default(0)
  sugar           Float    @default(0)
  sodium          Float    @default(0)
  // JSON: micro nutrients (vitamins, minerals)
  micronutrients  String   @default("{}")
  // JSON: allergens
  allergens       String   @default("[]")
  // JSON: dietary classifications
  dietaryTags     String   @default("[]")
  // How this was derived: CALCULATED | MANUAL | IMPORTED
  source          String   @default("MANUAL")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalog         FoodCatalog? @relation(fields: [catalogId], references: [id])

  @@index([entityType, entityId])
  @@index([catalogId])
}

model Allergen {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. "PEANUTS", "GLUTEN", "DAIRY"
  name            String
  nameLocalized   String   @default("{}")
  // Severity level
  severity        String   @default("HIGH") // LOW | MEDIUM | HIGH | CRITICAL
  // JSON: cross-contamination risk
  crossContaminationRisk String @default("{}")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([active])
}

model DietaryProfile {
  id              String   @id @default(cuid())
  code            String   @unique // VEGAN | VEGETARIAN | HALAL | KOSHER | GLUTEN_FREE | DAIRY_FREE | KETO | PALEO | LOW_SODIUM | DIABETIC_FRIENDLY
  name            String
  nameLocalized   String   @default("{}")
  description     String?
  // JSON: allowed ingredient categories
  allowedCategories String @default("[]")
  // JSON: forbidden ingredient categories
  forbiddenCategories String @default("[]")
  // JSON: forbidden allergens
  forbiddenAllergens String @default("[]")
  // Whether this is a system profile (vs custom)
  isSystem        Boolean  @default(true)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([active])
}

// --- Menu Platform (extends M6 Menu) ---

model MenuVersion {
  id              String   @id @default(cuid())
  menuId          String
  version         Int
  // JSON: full menu snapshot
  snapshot        String   @default("{}")
  // DRAFT | PUBLISHED | ARCHIVED
  status          String   @default("DRAFT")
  // JSON: seasonal availability { startDate, endDate }
  seasonal        String   @default("{}")
  // JSON: regional scope
  regional        String   @default("[]")
  publishedAt     DateTime?
  createdAt       DateTime @default(now())

  @@unique([menuId, version])
  @@index([menuId])
  @@index([status])
}

model MenuModifier {
  id              String   @id @default(cuid())
  menuItemId      String
  name            String
  // JSON: options (e.g. [{ name: "Extra spicy", priceRef: 5 }])
  options         String   @default("[]")
  // Whether this modifier is required
  required        Boolean  @default(false)
  // Max selections (0 = unlimited)
  maxSelections   Int      @default(1)
  createdAt       DateTime @default(now())

  @@index([menuItemId])
}

model MenuBundle {
  id              String   @id @default(cuid())
  menuId          String
  name            String
  description     String?
  // JSON: bundle items (menuItem IDs + quantities)
  items           String   @default("[]")
  // JSON: availability constraints
  availability    String   @default("{}")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([menuId])
}

// --- Inventory Platform (extends M6 Inventory) ---

model InventoryLocation {
  id              String   @id @default(cuid())
  organizationId  String
  name            String
  // WAREHOUSE | KITCHEN | STORAGE_ROOM | REFRIGERATOR | FREEZER | DRY_STORAGE | MOBILE
  type            String   @default("STORAGE_ROOM")
  // JSON: address / coordinates
  location        String   @default("{}")
  // JSON: capacity metadata
  capacity        String   @default("{}")
  // Temperature range in Celsius
  minTempC        Float?
  maxTempC        Float?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movements       InventoryMovement[]
  reservations    InventoryReservation[]

  @@index([organizationId])
  @@index([type])
}

model InventoryMovement {
  id              String   @id @default(cuid())
  inventoryId     String
  locationId      String?
  // RECEIVE | TRANSFER | CONSUME | ADJUST | WASTE | SPOILAGE | RETURN
  type            String
  // Quantity moved (positive for in, negative for out)
  quantity        Float
  unit            String   @default("g")
  // From location (for transfers)
  fromLocationId  String?
  // To location (for transfers)
  toLocationId    String?
  // Batch reference
  batchId         String?
  // JSON: metadata (reason, reference, etc.)
  metadata        String   @default("{}")
  // Audit
  performedById   String?
  correlationId   String?
  createdAt       DateTime @default(now())

  location        InventoryLocation? @relation(fields: [locationId], references: [id])

  @@index([inventoryId])
  @@index([type])
  @@index([createdAt])
}

model InventoryReservation {
  id              String   @id @default(cuid())
  inventoryId     String
  locationId      String?
  // Who reserved this
  reservedById    String
  quantity        Float
  unit            String   @default("g")
  // JSON: reference (booking code, order ID, etc.)
  reference       String   @default("{}")
  // PENDING | CONFIRMED | RELEASED | CONSUMED
  status          String   @default("PENDING")
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  location        InventoryLocation? @relation(fields: [locationId], references: [id])

  @@index([inventoryId])
  @@index([status])
}

model InventoryAudit {
  id              String   @id @default(cuid())
  inventoryId     String
  // The expected quantity (from system)
  expectedQuantity Float
  // The actual counted quantity
  actualQuantity  Float
  unit            String   @default("g")
  // The variance (actual - expected)
  variance        Float
  // JSON: findings
  findings        String   @default("[]")
  performedById   String
  performedAt     DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([inventoryId])
  @@index([performedAt])
}

model WasteRecord {
  id              String   @id @default(cuid())
  organizationId  String
  inventoryId     String?
  batchId         String?
  // SPOILAGE | PREPARATION_WASTE | OVERPRODUCTION | EXPIRED | DAMAGED
  type            String
  quantity        Float
  unit            String   @default("g")
  // Reason for waste
  reason          String?
  // JSON: metadata
  metadata        String   @default("{}")
  recordedById    String
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([type])
  @@index([createdAt])
}

// --- Measurement System ---

model MeasurementUnit {
  id              String   @id @default(cuid())
  code            String   @unique // g | kg | oz | lb | ml | L | cup | tbsp | tsp | piece | bunch
  name            String
  nameLocalized   String   @default("{}")
  // WEIGHT | VOLUME | COUNT
  type            String   @default("WEIGHT")
  // Base unit in this type (e.g. g for WEIGHT, ml for VOLUME)
  baseUnit        String
  // Conversion factor to base unit (e.g. kg → 1000g, oz → 28.35g)
  baseFactor      Float
  // JSON: localized variants (e.g. { en: "cup", tw: "kuruwa" })
  localizedVariants String @default("{}")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([type])
  @@index([active])
}

model ConversionRule {
  id              String   @id @default(cuid())
  fromUnit        String
  toUnit          String
  // Conversion factor (multiply from-value by this to get to-value)
  factor          Float
  // Whether this conversion is density-aware (requires an ingredient)
  densityAware    Boolean  @default(false)
  // Ingredient-specific density (g per ml) — for density-aware conversions
  ingredientCode  String?
  density         Float?
  createdAt       DateTime @default(now())

  @@unique([fromUnit, toUnit, ingredientCode])
  @@index([fromUnit, toUnit])
}

// --- Import/Export ---

model CatalogImport {
  id              String   @id @default(cuid())
  organizationId  String
  // CSV | XLSX | JSON | SUPPLIER_CATALOG | BARCODE
  format          String
  // The source file name or reference
  source          String
  // PENDING | VALIDATING | PREVIEW | IMPORTING | COMPLETED | FAILED | ROLLED_BACK
  status          String   @default("PENDING")
  totalRows       Int      @default(0)
  validRows       Int      @default(0)
  invalidRows     Int      @default(0)
  importedRows    Int      @default(0)
  // JSON: validation errors
  errors          String   @default("[]")
  // JSON: column mapping
  columnMapping   String   @default("{}")
  performedById   String
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  rows            CatalogImportRow[]

  @@index([organizationId])
  @@index([status])
}

model CatalogImportRow {
  id              String   @id @default(cuid())
  importId        String
  rowIndex        Int
  // JSON: raw row data
  rawData         String   @default("{}")
  // JSON: mapped data
  mappedData      String   @default("{}")
  // VALID | INVALID | IMPORTED | SKIPPED
  status          String   @default("PENDING")
  // Validation errors for this row
  errors          String   @default("[]")
  // The created catalog item ID (if imported)
  catalogId       String?
  createdAt       DateTime @default(now())

  import          CatalogImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  catalog         FoodCatalog? @relation(fields: [catalogId], references: [id])

  @@index([importId])
  @@index([status])
}

model CatalogExport {
  id              String   @id @default(cuid())
  organizationId  String
  // CSV | XLSX | JSON
  format          String
  // JSON: export filters
  filters         String   @default("{}")
  totalItems      Int      @default(0)
  // PENDING | EXPORTING | COMPLETED | FAILED
  status          String   @default("PENDING")
  // The export file URL
  fileUrl         String?
  performedById   String
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([organizationId])
  @@index([status])
}
