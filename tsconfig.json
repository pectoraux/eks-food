{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@eks/common": ["./src/packages/common/index.ts"],
      "@eks/config": ["./src/packages/config/index.ts"],
      "@eks/errors": ["./src/packages/errors/index.ts"],
      "@eks/observability": ["./src/packages/observability/index.ts"],
      "@eks/events": ["./src/packages/events/index.ts"],
      "@eks/cache": ["./src/packages/cache/index.ts"],
      "@eks/features": ["./src/packages/features/index.ts"],
      "@eks/api": ["./src/packages/api/index.ts"],
      "@eks/workers": ["./src/packages/workers/index.ts"],
      "@eks/security": ["./src/packages/security/index.ts"],
      "@eks/payments": ["./src/packages/payments/index.ts"],
      "@eks/testing": ["./src/packages/testing/index.ts"],
      "@eks/domain": ["./src/packages/domain/index.ts"],
      "@eks/identity": ["./src/packages/identity/index.ts"],
      "@eks/auth": ["./src/packages/auth/index.ts"],
      "@eks/authorization": ["./src/packages/authorization/index.ts"],
      "@eks/organizations": ["./src/packages/organizations/index.ts"],
      "@eks/notifications": ["./src/packages/notifications/index.ts"],
      "@eks/verification": ["./src/packages/verification/index.ts"],
      "@eks/*": ["./src/packages/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
